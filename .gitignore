# Lista blanca: versionar solo README, los manifiestos del plugin, los agentes, las skills y los plugins aparte.
/*

!.gitignore
!.gitattributes
!README.md
!.claude-plugin/
!agents/
!skills/
!plugins/

# skill-creator queda fuera: es de Anthropic, no del usuario.
skills/skill-creator/

# Ruido dentro de las skills versionadas:
**/node_modules/
**/__pycache__/
**/.DS_Store
**/*-workspace/

# Tipos que Claude Code escribe junto a cada mod al cargarlo:
plugins/*/.claude-plugin/types/
